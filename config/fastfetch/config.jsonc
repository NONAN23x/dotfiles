{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/sakura.png",
        "type": "auto",
        "height": 15,
        "width": 32,
        "padding": {
            "top": 4,
            "right": 6,
            "left": 4
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;196;167;231m┌─────────Hardware─────────────────────────────┐\u001b[0m"
        },
        {
            "type": "host",
            "key": "󰌢 Laptop",
            "keyColor": "#c4a7e7",
            "format": "{name}"
        },
        {
            "type": "display",
            "key": "│ ├ Display",
            "keyColor": "#c4a7e7",
            "format": "{width}*{height} @{refresh-rate}Hz {inch}″"
        },
        {
            "type": "cpu",
            "key": "│ ├󰻠 CPU",
            "keyColor": "#c4a7e7",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "key": "│ ├󰍛 GPU",
            "keyColor": "#c4a7e7",
            "format": "{vendor} {name}"
        },
        {
            "type": "disk",
            "key": "│ ├ Disk",
            "keyColor": "#c4a7e7",
            "format": "{size-used} / {size-total} ({size-percentage}) {filesystem}"
        },
        {
            "type": "memory",
            "key": "│ └󰘚 RAM",
            "keyColor": "#c4a7e7"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;196;167;231m└──────────────────────────────────────────────┘\u001b[0m"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;156;207;216m┌─────────Software─────────────────────────────┐\u001b[0m"
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "#9ccfd8"
        },
        {
            "type": "de",
            "key": "│ ├ DE",
            "keyColor": "#9ccfd8"
        },
        {
            "type": "wm",
            "key": "│ ├ WM",
            "keyColor": "#9ccfd8"
        },
        {
            "type": "kernel",
            "key": "│ ├ Kernel",
            "keyColor": "#9ccfd8"
        },
        {
            "type": "terminal",
            "key": "│ ├ Terminal",
            "keyColor": "#9ccfd8"
        },
        {
            "type": "terminalfont",
            "key": "│ ├󰛖 Font",
            "keyColor": "#9ccfd8"
        },
        {
            "type": "packages",
            "key": "│ ├󰏖 Packages",
            "keyColor": "#9ccfd8"
        },
        {
            "type": "shell",
            "key": "│ └ Shell",
            "keyColor": "#9ccfd8"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;156;207;216m└──────────────────────────────────────────────┘\u001b[0m"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;246;193;119m┌─────────Misc─────────────────────────────────┐\u001b[0m"
        },
        {
            "type": "command",
            "key": "│ 󰔟 OS Age",
            "keyColor": "#f6c177",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "│  Uptime",
            "keyColor": "#f6c177"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;246;193;119m└──────────────────────────────────────────────┘\u001b[0m"
        },
        {
            "type": "custom",
            "format": "               \u001b[38;2;110;106;134mRose Pine  \u001b[0m\u001b[48;2;25;23;36m  \u001b[0m\u001b[48;2;31;29;46m  \u001b[0m\u001b[48;2;38;35;58m  \u001b[0m\u001b[48;2;235;188;186m  \u001b[0m\u001b[48;2;49;116;143m  \u001b[0m\u001b[48;2;156;207;216m  \u001b[0m\u001b[48;2;196;167;231m  \u001b[0m\u001b[48;2;246;193;119m  \u001b[0m\u001b[48;2;235;111;146m  \u001b[0m\u001b[0m"
        }
    ]
}
